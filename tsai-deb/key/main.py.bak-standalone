#!/usr/bin/env python3
"""AI 助手 — HTML 套壳入口（chinai3 风格）。

保留 CLI 命令：--screenshot/--wake/--context 通过 IPC 发送到已运行实例。
布局沿用原版 GTK（顶部工具 + 聊天气泡 + 底部输入），风格仿照 chinai3。
"""
import os
import sys

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
if BASE_DIR not in sys.path:
    sys.path.insert(0, BASE_DIR)
if "/usr/chindows" not in sys.path:
    sys.path.insert(0, "/usr/chindows")

import server  # noqa: E402
from chindshell import shell  # noqa: E402
from ipc import Client  # noqa: E402


def main():
    args = sys.argv[1:]
    cmd = None
    for flag in ("--screenshot", "--wake", "--context"):
        if flag in args:
            cmd = flag.lstrip("-")
            break
    if cmd:
        try:
            if Client.send(cmd):
                print(f"[AI助手] IPC 已发送命令: {cmd}", flush=True)
                return 0
        except Exception:
            pass
        print(f"[AI助手] 无后台实例，将打开窗口处理: {cmd}", flush=True)

    shell.run(
        app_id="com.local.AiAssistant",
        prgname="com.local.AiAssistant",
        title="AI 助手",
        icon="dialog-information",
        server_module=server,
        width=900, height=720, min_w=620, min_h=480,
    )


if __name__ == "__main__":
    main()
